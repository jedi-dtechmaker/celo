generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
//  Users
// ──────────────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  fullName       String     @map("full_name")
  email          String     @unique
  password       String
  phone          String?
  country        String?
  walletAddress  String?    @map("wallet_address")
  role           UserRole   @default(BUYER)
  avatar         String?
  trustScore     Decimal?   @default(0.0) @map("trust_score") @db.Decimal(10, 2)
  verified       Boolean    @default(false)
  emailVerified  Boolean    @default(false) @map("email_verified")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  sellerProfile    SellerProfile?
  products         Product[]
  ordersAsBuyer    Order[]        @relation("BuyerOrders")
  ordersAsSeller   Order[]        @relation("SellerOrders")
  reviewsGiven     Review[]       @relation("Reviewer")
  reviewsReceived  Review[]       @relation("Seller")
  negotiations     Negotiation[]
  autobuyRules     AutoBuyRule[]
  notifications    Notification[]
  wishlistItems    Wishlist[]
  savedSearches    SavedSearch[]
  aiActivityLogs   AiActivityLog[]

  @@map("users")
}

// ──────────────────────────────────────────────
//  Seller Profiles
// ──────────────────────────────────────────────

model SellerProfile {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @unique @map("user_id") @db.Uuid
  businessName        String  @map("business_name")
  businessDescription String? @map("business_description") @db.Text
  address             String? @db.Text
  website             String?
  logo                String?
  registrationNumber  String? @map("registration_number")
  responseTime        Int?    @map("response_time")
  completedOrders     Int?    @default(0) @map("completed_orders")
  averageRating       Decimal? @default(0.0) @map("average_rating") @db.Decimal(3, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("seller_profiles")
}

// ──────────────────────────────────────────────
//  Categories
// ──────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

// ──────────────────────────────────────────────
//  Products
// ──────────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  DELETED
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  sellerId     String        @map("seller_id") @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  title        String
  description  String?       @db.Text
  unit         String
  quantity     Decimal       @db.Decimal(15, 2)
  minimumOrder Decimal       @default(1.0) @map("minimum_order") @db.Decimal(15, 2)
  unitPrice    Decimal       @map("unit_price") @db.Decimal(15, 2)
  currency     String        @default("cUSD")
  country      String?
  deliveryDays Int?          @map("delivery_days")
  status       ProductStatus @default(ACTIVE)
  featured     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  seller  User      @relation(fields: [sellerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  images        ProductImage[]
  orders        Order[]
  wishlistItems Wishlist[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([country])
  @@index([unitPrice])
  @@map("products")
}

// ──────────────────────────────────────────────
//  Product Images
// ──────────────────────────────────────────────

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  imageUrl  String @map("image_url")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_images")
}

// ──────────────────────────────────────────────
//  Orders
// ──────────────────────────────────────────────

enum OrderStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  ESCROW_FUNDED
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  buyerId          String      @map("buyer_id") @db.Uuid
  sellerId         String      @map("seller_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  quantity         Decimal     @db.Decimal(15, 2)
  agreedPrice      Decimal     @map("agreed_price") @db.Decimal(15, 2)
  totalAmount      Decimal     @map("total_amount") @db.Decimal(15, 2)
  orderStatus      OrderStatus @default(PENDING) @map("order_status")
  shippingAddress  String?     @map("shipping_address") @db.Text
  expectedDelivery DateTime?   @map("expected_delivery")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  buyer  User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller User    @relation("SellerOrders", fields: [sellerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  escrow       Escrow?
  timeline     OrderTimeline[]
  negotiations Negotiation[]
  reviews      Review[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([orderStatus])
  @@map("orders")
}

// ──────────────────────────────────────────────
//  Order Timeline
// ──────────────────────────────────────────────

model OrderTimeline {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  status      String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_timeline")
}

// ──────────────────────────────────────────────
//  Escrows
// ──────────────────────────────────────────────

enum EscrowStatus {
  CREATED
  FUNDED
  ACCEPTED
  SHIPPED
  DELIVERED
  RELEASED
  CANCELLED
  REFUNDED
  DISPUTED
}

model Escrow {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @unique @map("order_id") @db.Uuid
  escrowContract   String?      @map("escrow_contract")
  transactionHash  String?      @map("transaction_hash")
  blockchainStatus EscrowStatus @default(CREATED) @map("blockchain_status")
  amount           Decimal      @db.Decimal(15, 2)
  currency         String       @default("cUSD")
  platformFee      Decimal      @default(0.0) @map("platform_fee") @db.Decimal(15, 2)
  escrowId         Int?         @map("escrow_id") // on-chain escrow ID
  releasedAt       DateTime?    @map("released_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  order        Order          @relation(fields: [orderId], references: [id])
  transactions Transaction[]

  @@index([transactionHash])
  @@map("escrows")
}

// ──────────────────────────────────────────────
//  Transactions
// ──────────────────────────────────────────────

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  escrowId  String   @map("escrow_id") @db.Uuid
  txHash    String   @map("tx_hash")
  wallet    String
  network   String   @default("celo-mainnet")
  token     String   @default("cUSD")
  amount    Decimal  @db.Decimal(15, 2)
  status    TxStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")

  escrow Escrow @relation(fields: [escrowId], references: [id])

  @@map("transactions")
}

// ──────────────────────────────────────────────
//  Reviews
// ──────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @map("order_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  rating     Int
  title      String?
  review     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id])
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id])
  seller  User @relation("Seller", fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("reviews")
}

// ──────────────────────────────────────────────
//  Negotiations
// ──────────────────────────────────────────────

enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

model Negotiation {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  senderId     String            @map("sender_id") @db.Uuid
  offeredPrice Decimal           @map("offered_price") @db.Decimal(15, 2)
  message      String?           @db.Text
  status       NegotiationStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id])
  sender User  @relation(fields: [senderId], references: [id])

  @@map("negotiations")
}

// ──────────────────────────────────────────────
//  AutoBuy Rules
// ──────────────────────────────────────────────

model AutoBuyRule {
  id                  String   @id @default(uuid()) @db.Uuid
  buyerId             String   @map("buyer_id") @db.Uuid
  productName         String   @map("product_name")
  categoryId          String?  @map("category_id") @db.Uuid
  maximumPrice        Decimal? @map("maximum_price") @db.Decimal(15, 2)
  quantity            Decimal? @db.Decimal(15, 2)
  preferredCountry    String?  @map("preferred_country")
  minimumRating       Decimal? @map("minimum_rating") @db.Decimal(3, 2)
  minimumTrustScore   Decimal? @map("minimum_trust_score") @db.Decimal(10, 2)
  maximumDeliveryDays Int?     @map("maximum_delivery_days")
  budget              Decimal? @db.Decimal(15, 2)
  expiresAt           DateTime? @map("expires_at")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")

  buyer User @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
  @@map("autobuy_rules")
}

// ──────────────────────────────────────────────
//  AI Activity Logs
// ──────────────────────────────────────────────

model AiActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  agent         String
  action        String
  input         Json?    @db.JsonB
  output        Json?    @db.JsonB
  executionTime Int?     @map("execution_time")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("ai_activity_logs")
}

// ──────────────────────────────────────────────
//  Notifications
// ──────────────────────────────────────────────

enum NotificationType {
  ORDER_UPDATE
  ESCROW_UPDATE
  AI_ALERT
  AUTOBUY_ALERT
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String           @db.Text
  type      NotificationType @default(ORDER_UPDATE)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ──────────────────────────────────────────────
//  Wishlists
// ──────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("wishlists")
}

// ──────────────────────────────────────────────
//  Saved Searches
// ──────────────────────────────────────────────

model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  query     String   @db.Text
  filters   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("saved_searches")
}

// ──────────────────────────────────────────────
//  Disputes
// ──────────────────────────────────────────────

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Dispute {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @unique @map("order_id") @db.Uuid
  buyerId    String        @map("buyer_id") @db.Uuid
  sellerId   String        @map("seller_id") @db.Uuid
  reason     String        @db.Text
  resolution String?       @db.Text
  status     DisputeStatus @default(OPEN)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("disputes")
}
